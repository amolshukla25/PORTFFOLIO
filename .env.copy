# Google Form (contact form submission backend)
GOOGLE_FORM_LINK=""
GOOGLE_FORM_FIELD_ID_NAME=""
GOOGLE_FORM_FIELD_ID_EMAIL=""
GOOGLE_FORM_FIELD_ID_MESSAGE=""
GOOGLE_FORM_FIELD_ID_SOCIAL=""

# Public site links
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=""
NEXT_PUBLIC_RESUME_LINK=""

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Session signing secret
AUTH_SECRET="<random-64-char-hex-string>"

# Auth toggle. Leave these unset (or any non-"true" value) to run the portals
# in viewing mode where authentication is disabled. Set both to "true" to
# require real logins: AUTH_ENABLED=true  NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false

# Optional seed overrides
SEED_ADMIN_NAME="Amol Shukla"
SEED_ADMIN_EMAIL="admin@amolshukla.online"
SEED_ADMIN_PASSWORD="Admin@12345"
